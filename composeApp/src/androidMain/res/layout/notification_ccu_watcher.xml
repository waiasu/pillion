<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="40dp" android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView android:id="@+id/ccu_state"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:singleLine="true" android:ellipsize="end"
        android:textSize="14sp" android:textColor="?android:attr/textColorPrimary"/>
    <TextView android:id="@+id/ccu_stop"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:minWidth="70dp" android:gravity="center"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:textSize="13sp" android:textColor="?android:attr/textColorPrimary"
        android:clickable="true"/>
</LinearLayout>
